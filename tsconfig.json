{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"types": ["node", "$app/types"],
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"test/**/*.js",
		"test/**/*.ts",
		"test/**/*.svelte"
	],
	"exclude": ["node_modules/**", "build/**"]
}
